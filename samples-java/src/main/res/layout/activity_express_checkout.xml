<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/RenderDemoHeader"
            android:layout_marginTop="0dp"
            android:text="@string/express_demo_merchant" />

        <TextView
            android:id="@+id/environment"
            style="@style/RenderDemoNote" />

        <EditText
            android:id="@+id/public_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/express_demo_public_key"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/callback_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/express_demo_callback_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            style="@style/RenderDemoNote"
            android:text="@string/express_demo_merchant_note" />

        <TextView
            style="@style/RenderDemoHeader"
            android:text="@string/express_demo_xml" />

        <com.affirm.android.AffirmCheckoutButton
            android:id="@+id/xml_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:affirmButtonShape="pill"
            app:affirmButtonSize="large"
            app:affirmButtonText="buyNow"
            app:affirmButtonTheme="dark"
            app:affirmFullWidth="true"
            app:affirmPageType="product" />

        <TextView
            style="@style/RenderDemoHeader"
            android:text="@string/express_demo_code" />

        <!-- Gray, so the borderless light theme stands out. -->
        <FrameLayout
            android:id="@+id/code_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/expressDemoPreview"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/style_toggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            style="@style/RenderDemoNote"
            android:text="@string/express_demo_buttons_note" />

        <TextView
            android:id="@+id/result"
            style="@style/RenderDemoStatus"
            android:freezesText="true"
            android:text="@string/express_demo_result_idle" />
    </LinearLayout>
</ScrollView>
